service=shell-service
image=shell-service
startup=eager
availability=required
ready_timeout=400
restart=on-failure:1:8
depends=console-service, log-service, config-service, storage-service, status-service, package-service, network-service, graphics-service, session-service, desktop-shell-service
lookup=console-service:send
lookup=log-service:send
lookup=config-service:send
lookup=storage-service:send
lookup=status-service:send
lookup=package-service:send
lookup=network-service:send
lookup=graphics-service:send
lookup=session-service:send
lookup=desktop-shell-service:send
lookup=audio-service:send
lookup=runtime-service:send
lookup=developer-service:send
lookup=security-service:send
